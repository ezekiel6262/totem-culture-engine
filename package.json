{
  "name": "totem-culture-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test backend/test/*.test.js",
    "test:static": "node scripts/build-site.js && node scripts/audit-static.mjs",
    "backend:demo": "node backend/scripts/demo.js",
    "start": "node backend/server.js",
    "db:migrate": "node backend/scripts/migrate.js",
    "build:wallet": "node scripts/build-wallet.js",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml --workspace",
    "build:contracts": "cargo build --manifest-path contracts/Cargo.toml --workspace --target wasm32-unknown-unknown --release",
    "build:lambda": "esbuild ./backend/lambda.js --bundle --platform=node --format=esm --target=node24 --outfile=./build/lambda.js",
    "build:site": "node scripts/build-site.js",
    "normalize": "node scripts/normalize-site.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1163.0",
    "@aws-sdk/lib-dynamodb": "^3.1163.0",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui-js": "^10.1.4",
    "buffer": "^6.0.3",
    "pg": "^8.23.1",
    "three": "^0.187.0",
    "util": "^0.12.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
